{
  "name": "yukicoder-ko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "audit:translations": "node --import tsx scripts/audit-translations.ts",
    "build": "node --import tsx scripts/build-extension.ts",
    "build:problems": "node --import tsx scripts/build-problem-translations.ts",
    "convert:problem": "node --import tsx scripts/convert-problem-html-to-mdx.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "review": "node --import tsx scripts/migrate-problem-review-status.ts && pnpm review:build && node --import tsx scripts/review-server.ts",
    "review:build": "node --import tsx scripts/build-review.ts",
    "pretest": "pnpm build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:problems": "node --import tsx scripts/validate-problem-translations.ts",
    "lint:problems": "node --import tsx scripts/lint-problem-html.ts",
    "verify:problems": "node --import tsx scripts/validate-problem-translations.ts --verify-source",
    "download:problems": "node --import tsx scripts/download-problem-corpus.ts",
    "package": "pnpm build && node --import tsx scripts/package-extension.ts"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@types/jsdom": "^27.0.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "katex": "^0.18.5",
    "lint-staged": "^17.4.1",
    "markdown-it": "^15.0.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.{json,js,mjs,ts,md,yml,yaml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}
