{
  "name": "yukicoder-ko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "audit:translations": "pnpm --filter translation-audit audit:translations",
    "build": "node --import tsx scripts/build-extension.ts",
    "build:icons": "node --import tsx scripts/build-toolbar-icons.ts",
    "build:problems": "pnpm --filter translation-audit build:problems",
    "convert:problem": "pnpm --filter translation-audit convert:problem",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review": "pnpm review:build && pnpm --filter translation-review start",
    "review:build": "pnpm --filter translation-review build",
    "test": "pnpm test:extension && pnpm --filter translation-core --filter translation-review --filter ui-collector-internal test",
    "test:extension": "node --import tsx --test src/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:problems": "pnpm --filter translation-audit validate:problems",
    "lint:problems": "pnpm --filter translation-audit lint:problems",
    "verify:problems": "pnpm --filter translation-audit verify:problems",
    "download:problems": "pnpm --filter translation-audit download:problems",
    "package": "pnpm build && pnpm package:built",
    "package:built": "node --import tsx scripts/package-extension.ts",
    "audit:ui-pages": "pnpm --filter translation-audit audit:ui-pages",
    "download:ui-pages": "pnpm --filter translation-audit download:ui-pages",
    "audit:ui-contexts": "pnpm --filter translation-audit audit:ui-contexts",
    "validate:ui": "pnpm --filter translation-audit validate:ui",
    "hooks:install": "simple-git-hooks",
    "setup": "pnpm --filter translation-audit run setup",
    "check": "pnpm format:check && pnpm schemas:check && pnpm typecheck && pnpm -r typecheck && pnpm validate:ui && pnpm validate:problems && pnpm lint:problems && pnpm build && pnpm review:build && pnpm build:problems && pnpm --filter ui-collector-internal build && pnpm test && pnpm --filter translation-audit test",
    "review:smoke": "pnpm --filter translation-review review:smoke",
    "audit:problems": "pnpm --filter translation-audit audit:problems",
    "schemas:generate": "node --import tsx scripts/generate-editor-schemas.ts",
    "schemas:check": "node --import tsx scripts/generate-editor-schemas.ts --check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^27.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "chrome-types": "^0.1.443",
    "esbuild": "^0.25.0",
    "jsdom": "^27.4.0",
    "katex": "^0.18.5",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.{json,js,mjs,ts,md,yml,yaml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "translation-core": "workspace:*"
  }
}
