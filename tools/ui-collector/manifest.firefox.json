{
  "manifest_version": 3,
  "name": "yukicoder UI collector (internal)",
  "version": "0.1.0",
  "description": "Collects evidence of remaining Japanese UI text on yukicoder.me.",
  "permissions": ["storage"],
  "host_permissions": ["https://yukicoder.me/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yukicoder-ui-collector@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "yukicoder UI collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://yukicoder.me/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
