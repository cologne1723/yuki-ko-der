{
  "manifest_version": 3,
  "name": "yukicoder 한국어 번역",
  "version": "0.1.0",
  "description": "yukicoder의 고정 UI 문구를 한국어로 번역합니다.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yukicoder-ko@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": [
    "https://yukicoder.me/*",
    "https://cologne1723.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://yukicoder.me/*"],
      "js": ["src/config.js", "src/problem-translations.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["translations/ko/*.json"],
      "matches": ["https://yukicoder.me/*"]
    }
  ]
}
