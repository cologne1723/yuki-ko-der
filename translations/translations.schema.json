{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yukicoder translation dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "sourceLocale",
    "translations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "sourceLocale": {
      "type": "string",
      "minLength": 2
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "source",
          "target"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
